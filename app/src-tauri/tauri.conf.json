{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeVoice",
  "version": "0.2.81",
  "identifier": "dev.zburgers.vibevoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeVoice",
        "width": 980,
        "height": 680,
        "minWidth": 560,
        "minHeight": 520,
        "alwaysOnTop": false,
        "decorations": false
      },
      {
        "label": "pill",
        "title": "VibeVoice Pill",
        "width": 196,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage", "dmg", "app"],
    "publisher": "Zburgers",
    "homepage": "https://github.com/Zburgers/vibevoice",
    "license": "LicenseRef-proprietary",
    "category": "Productivity",
    "shortDescription": "Local-first desktop voice input for developers",
    "longDescription": "VibeVoice records microphone audio, transcribes it locally with whisper.cpp, cleans developer terms, and copies or pastes the result into the focused app.",
    "resources": [
      "../../scripts/install-engine.sh",
      "../../scripts/install-fedora.sh",
      "../../scripts/install-app.sh",
      "../../scripts/install-app.ps1",
      "../../scripts/uninstall-app.sh",
      "../../scripts/uninstall-app.ps1",
      "../../scripts/install-windows.ps1",
      "../../scripts/check-system.sh",
      "../../scripts/check-windows.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/dev.zburgers.vibevoice.metainfo.xml": "linux/dev.zburgers.vibevoice.metainfo.xml"
        }
      },
      "deb": {
        "depends": [],
        "section": "sound",
        "files": {
          "/usr/share/metainfo/dev.zburgers.vibevoice.metainfo.xml": "linux/dev.zburgers.vibevoice.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/dev.zburgers.vibevoice.metainfo.xml": "linux/dev.zburgers.vibevoice.metainfo.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMjA5QUMxMzhFQjlENDcKUldSSG5lczR3Wm9nTFZjYVIrSzFzb2RYSVZCMDJoOTJTcEd5ZGdBdE1CblVxL0dHVVlET2tWSDQK",
      "endpoints": [
        "https://github.com/Zburgers/vibevoice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
